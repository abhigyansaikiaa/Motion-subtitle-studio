{
  "id": "pill",
  "name": "Pill",
  "description": "The active word slips into a clean white pill badge while the rest stays ghosted white.",
  "tags": [
    "word-by-word",
    "badge",
    "modern"
  ],
  "bestFor": "Tech explainers, product demos, SaaS reels",
  "version": "1.0.0",
  "layout": {
    "position": "center",
    "maxWidth": "88%",
    "textAlign": "center",
    "wordsPerLine": 3,
    "window": {
      "wordsBefore": 2,
      "wordsAfter": 2
    }
  },
  "text": {
    "fontFamily": "'Inter', sans-serif",
    "fontUrl": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap",
    "fontWeight": 700,
    "fontSize": "clamp(24px, 7vmin, 64px)",
    "lineHeight": 1.5,
    "color": "#ffffff",
    "textTransform": "none",
    "letterSpacing": "0.01em",
    "stroke": null,
    "shadow": "0 2px 8px rgba(0,0,0,0.7)",
    "background": null,
    "borderRadius": null,
    "padding": null
  },
  "behavior": {
    "mode": "word-by-word",
    "active": {
      "color": "#111111",
      "background": "#ffffff",
      "scale": 1.1
    },
    "past": {
      "color": "#ffffff",
      "opacity": 1.0
    },
    "upcoming": {
      "color": "#ffffff",
      "opacity": 0.6
    },
    "animation": {
      "keyframes": "capPop",
      "duration": "0.28s",
      "easing": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  },
  "cssClass": "cap-tpl-pill"
}

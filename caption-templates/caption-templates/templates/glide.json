{
  "id": "glide",
  "name": "Glide",
  "description": "Words glide in smoothly from the right as they are spoken \u2014 sleek and modern.",
  "tags": [
    "word-by-word",
    "smooth",
    "modern"
  ],
  "bestFor": "Tech reviews, modern brand content",
  "version": "1.0.0",
  "layout": {
    "position": "center",
    "maxWidth": "88%",
    "textAlign": "center",
    "wordsPerLine": 3,
    "window": {
      "wordsBefore": 2,
      "wordsAfter": 2
    }
  },
  "text": {
    "fontFamily": "'Inter', sans-serif",
    "fontUrl": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap",
    "fontWeight": 700,
    "fontSize": "clamp(26px, 7.5vmin, 68px)",
    "lineHeight": 1.3,
    "color": "#ffffff",
    "textTransform": "uppercase",
    "letterSpacing": "0.02em",
    "stroke": {
      "width": "2px",
      "color": "#000000"
    },
    "shadow": "0 3px 0 rgba(0,0,0,0.85)",
    "background": null,
    "borderRadius": null,
    "padding": null
  },
  "behavior": {
    "mode": "word-by-word",
    "active": {
      "color": "#7DF9FF",
      "scale": 1.1
    },
    "past": {
      "color": "#ffffff",
      "opacity": 1.0
    },
    "upcoming": {
      "color": "#ffffff",
      "opacity": 0.55
    },
    "animation": {
      "keyframes": "capGlideIn",
      "duration": "0.35s",
      "easing": "cubic-bezier(0.22, 1, 0.36, 1)"
    }
  },
  "cssClass": "cap-tpl-glide"
}

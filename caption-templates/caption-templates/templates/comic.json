{
  "id": "comic",
  "name": "Comic",
  "description": "Chunky comic-book lettering on a white speech bubble, tilted for attitude. POW!",
  "tags": [
    "word-by-word",
    "playful",
    "bubble"
  ],
  "bestFor": "Comedy skits, memes, kid-friendly videos",
  "version": "1.0.0",
  "layout": {
    "position": "center",
    "maxWidth": "88%",
    "textAlign": "center",
    "wordsPerLine": 3,
    "window": {
      "wordsBefore": 2,
      "wordsAfter": 2
    }
  },
  "text": {
    "fontFamily": "'Bangers', cursive",
    "fontUrl": "https://fonts.googleapis.com/css2?family=Bangers&display=swap",
    "fontWeight": 400,
    "fontSize": "clamp(32px, 9vmin, 80px)",
    "lineHeight": 1.2,
    "color": "#111111",
    "textTransform": "uppercase",
    "letterSpacing": "0.03em",
    "stroke": null,
    "shadow": "4px 4px 0 rgba(0,0,0,1)",
    "background": "#ffffff",
    "borderRadius": "18px",
    "padding": "0.15em 0.5em"
  },
  "behavior": {
    "mode": "word-by-word",
    "active": {
      "color": "#FF3D00",
      "scale": 1.25
    },
    "past": {
      "color": "#111111",
      "opacity": 1.0
    },
    "upcoming": {
      "color": "#111111",
      "opacity": 1.0
    },
    "animation": {
      "keyframes": "capStickerIn",
      "duration": "0.3s",
      "easing": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  },
  "cssClass": "cap-tpl-comic"
}

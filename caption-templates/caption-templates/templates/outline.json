{
  "id": "outline",
  "name": "Outline",
  "description": "Hollow outline type where the spoken word fills solid yellow \u2014 striking on dark footage.",
  "tags": [
    "word-by-word",
    "outline",
    "bold"
  ],
  "bestFor": "Music videos, fashion edits, bold statements",
  "version": "1.0.0",
  "layout": {
    "position": "center",
    "maxWidth": "88%",
    "textAlign": "center",
    "wordsPerLine": 3,
    "window": {
      "wordsBefore": 2,
      "wordsAfter": 2
    }
  },
  "text": {
    "fontFamily": "'Anton', sans-serif",
    "fontUrl": "https://fonts.googleapis.com/css2?family=Anton&display=swap",
    "fontWeight": 400,
    "fontSize": "clamp(30px, 8.5vmin, 78px)",
    "lineHeight": 1.2,
    "color": "transparent",
    "textTransform": "uppercase",
    "letterSpacing": "0.03em",
    "stroke": {
      "width": "2px",
      "color": "#ffffff"
    },
    "shadow": null,
    "background": null,
    "borderRadius": null,
    "padding": null
  },
  "behavior": {
    "mode": "word-by-word",
    "active": {
      "color": "#FFE500",
      "scale": 1.15
    },
    "past": {
      "color": "transparent",
      "opacity": 1.0
    },
    "upcoming": {
      "color": "transparent",
      "opacity": 1.0
    },
    "animation": {
      "keyframes": "capPop",
      "duration": "0.28s",
      "easing": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  },
  "cssClass": "cap-tpl-outline"
}

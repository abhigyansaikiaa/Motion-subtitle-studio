{
  "id": "sticker",
  "name": "Sticker",
  "description": "Die-cut sticker text with a thick white border, tilted -3 degrees and a hard offset shadow.",
  "tags": [
    "word-by-word",
    "sticker",
    "bold"
  ],
  "bestFor": "Memes, reaction videos, sticker-style edits",
  "version": "1.0.0",
  "layout": {
    "position": "center",
    "maxWidth": "88%",
    "textAlign": "center",
    "wordsPerLine": 3,
    "window": {
      "wordsBefore": 2,
      "wordsAfter": 2
    }
  },
  "text": {
    "fontFamily": "'Anton', sans-serif",
    "fontUrl": "https://fonts.googleapis.com/css2?family=Anton&display=swap",
    "fontWeight": 400,
    "fontSize": "clamp(30px, 9vmin, 80px)",
    "lineHeight": 1.25,
    "color": "#FF4D8D",
    "textTransform": "uppercase",
    "letterSpacing": "0.02em",
    "stroke": {
      "width": "10px",
      "color": "#ffffff"
    },
    "shadow": "6px 6px 0 rgba(0,0,0,1)",
    "background": null,
    "borderRadius": null,
    "padding": null
  },
  "behavior": {
    "mode": "word-by-word",
    "active": {
      "color": "#FFD400",
      "scale": 1.22
    },
    "past": {
      "color": "#FF4D8D",
      "opacity": 1.0
    },
    "upcoming": {
      "color": "#FF4D8D",
      "opacity": 1.0
    },
    "animation": {
      "keyframes": "capStickerIn",
      "duration": "0.3s",
      "easing": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  },
  "cssClass": "cap-tpl-sticker"
}

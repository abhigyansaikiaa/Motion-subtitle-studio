{
  "id": "focus-card",
  "name": "Focus Card",
  "description": "A frosted-glass card spotlights the active phrase while the rest of the line recedes.",
  "tags": [
    "word-by-word",
    "card",
    "glass"
  ],
  "bestFor": "Quotes, affirmations, premium brand content",
  "version": "1.0.0",
  "layout": {
    "position": "center",
    "maxWidth": "86%",
    "textAlign": "center",
    "wordsPerLine": 4,
    "window": {
      "wordsBefore": 2,
      "wordsAfter": 2
    }
  },
  "text": {
    "fontFamily": "'Inter', sans-serif",
    "fontUrl": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap",
    "fontWeight": 600,
    "fontSize": "clamp(22px, 6vmin, 52px)",
    "lineHeight": 1.5,
    "color": "#ffffff",
    "textTransform": "none",
    "letterSpacing": "0.01em",
    "stroke": null,
    "shadow": "0 2px 8px rgba(0,0,0,0.5)",
    "background": "rgba(255,255,255,0.1)",
    "borderRadius": "20px",
    "padding": "0.6em 0.9em"
  },
  "behavior": {
    "mode": "word-by-word",
    "active": {
      "color": "#FFE500",
      "scale": 1.12
    },
    "past": {
      "color": "#ffffff",
      "opacity": 0.4
    },
    "upcoming": {
      "color": "#ffffff",
      "opacity": 0.4
    },
    "animation": {
      "keyframes": "capPop",
      "duration": "0.28s",
      "easing": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  },
  "cssClass": "cap-tpl-focus-card"
}

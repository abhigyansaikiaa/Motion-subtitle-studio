{
  "id": "box-highlight",
  "name": "Box Highlight",
  "description": "The spoken word gets stamped inside a solid yellow box with black text \u2014 impossible to miss.",
  "tags": [
    "word-by-word",
    "highlight",
    "bold"
  ],
  "bestFor": "Key takeaways, listicles, sales videos",
  "version": "1.0.0",
  "layout": {
    "position": "center",
    "maxWidth": "88%",
    "textAlign": "center",
    "wordsPerLine": 3,
    "window": {
      "wordsBefore": 2,
      "wordsAfter": 2
    }
  },
  "text": {
    "fontFamily": "'Inter', sans-serif",
    "fontUrl": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap",
    "fontWeight": 800,
    "fontSize": "clamp(26px, 7.5vmin, 68px)",
    "lineHeight": 1.35,
    "color": "#ffffff",
    "textTransform": "uppercase",
    "letterSpacing": "0.01em",
    "stroke": {
      "width": "2px",
      "color": "#000000"
    },
    "shadow": "0 3px 0 rgba(0,0,0,0.85)",
    "background": null,
    "borderRadius": null,
    "padding": null
  },
  "behavior": {
    "mode": "word-by-word",
    "active": {
      "color": "#111111",
      "background": "#FFE500",
      "scale": 1.12
    },
    "past": {
      "color": "#ffffff",
      "opacity": 1.0
    },
    "upcoming": {
      "color": "#ffffff",
      "opacity": 1.0
    },
    "animation": {
      "keyframes": "capPop",
      "duration": "0.25s",
      "easing": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  },
  "cssClass": "cap-tpl-box-highlight"
}
